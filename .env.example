# Copy this file to .env and fill in what you have. Everything is OPTIONAL:
# the app also has a Settings page where you can enter the same values and
# test them with one click. Values saved from the Settings page are stored in
# data/settings.json and override this file. Never commit .env or
# data/settings.json -- both are gitignored.

# --- LLM provider -----------------------------------------------------------
# One of: mock | groq | gemini | openai | ollama
# "mock" needs no key: built-in expert rules recommend a fix for every issue.
LLM_PROVIDER=groq
# Leave blank to use each provider's default
# (groq: openai/gpt-oss-120b, gemini: gemini-2.5-flash,
#  openai: gpt-4o-mini, ollama: llama3.1)
LLM_MODEL=

# Only the key matching LLM_PROVIDER is needed.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Ollama runs locally; only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- How strict should the checks be? ---------------------------------------
# A column is reported as incomplete once this share of it is blank.
MISSING_WARN_PCT=5
# Above this share, the issue is marked critical.
MISSING_CRITICAL_PCT=40
# Outlier sensitivity, as a multiple of the inter-quartile range.
# Lower finds more: 1.5 is aggressive, 3 is conservative.
OUTLIER_IQR_MULTIPLIER=3
# Outliers are not reported on a column with fewer than this many values,
# because a handful of numbers has no meaningful "normal range".
OUTLIER_MIN_ROWS=20
# A column counts as mixed-type once more than this share of it fails to look
# numeric while the rest looks numeric.
MIXED_TYPE_TOLERANCE_PCT=2
# Casing checks are skipped for columns where almost every value is unique,
# since those are identifiers rather than categories.
HIGH_CARDINALITY_RATIO=0.5

# --- Review behaviour --------------------------------------------------------
# Reserved: pre-tick non-destructive fixes on the review screen.
AUTO_APPROVE_SAFE_FIXES=false
# How many issues are sent to the AI in one run. Anything beyond this gets a
# recommendation from the built-in rules instead, to bound cost and latency.
MAX_ISSUES_ADVISED=40

# --- LangSmith tracing (optional, recommended) ------------------------------
# Create a free key at https://smith.langchain.com. When set, every workflow
# node and LLM call is traced automatically.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=data-quality-agent

# --- App --------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8401
DATA_DIR=./data
